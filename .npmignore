# proctoring.js — files excluded from the npm package.
#
# The published tarball should contain `dist/`, `README.md`, and `LICENSE` only
# (see the `files` field in package.json). This file keeps the pack clean even
# if `files` is ever loosened.

# Local face-api weights — ~18MB, superseded by the CDN provider
models/

# Source is published through `dist` only; keep the tarball small
src/
vite.config.js
demo.html

# Frozen vanilla-JS prototype, kept for the record only. `files` already
# excludes it; listed here so loosening `files` cannot accidentally publish a
# dead app.
legacy/

# Static demo site and its tooling — hosted separately, not part of the package
netlify-demo/
scripts/

# Maintainer notes. Not a secret, but publishing it would change the tarball for
# no consumer benefit — and the README-parity rule in CONTRIBUTING.md only holds
# as long as the tarball contents stay exactly as `files` declares them.
CONTRIBUTING.md

# Tooling and CI
.github/
.vscode/
.idea/
*.log
.env
.env.*

# OS noise
.DS_Store
Thumbs.db
